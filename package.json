{
  "name": "chessray",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/chessraygg/chessray.git"
  },
  "description": "Electron app for real-time chess position recognition and evaluation from video",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:core": "cd packages/core && npx vitest run",
    "test:electron": "cd packages/electron && npx vitest run",
    "test:watch": "cd packages/core && npx vitest",
    "setup": "node scripts/download-vendor.js",
    "gen-expected": "tsx scripts/gen-expected-images.ts",
    "gen-expected-sequences": "tsx scripts/gen-expected-sequences.ts"
  },
  "dependencies": {
    "onnxruntime-node": "^1.24.3"
  },
  "overrides": {
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^2.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "js-yaml": "^4.1.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.42.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
